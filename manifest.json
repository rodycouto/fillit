{
  "manifest_version": 3,
  "name": "Fillit",
  "version": "1.0.0",
  "description": "Preencha formulários em segundos usando valores que você mesmo cadastra.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Fillit — Preencher Formulários",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/js/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Abrir o Fillit"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}