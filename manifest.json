{
    "manifest_version": 3,
    "name": "Fillit",
    "version": "1.0",
    "description": "Preenche formulários com dados salvos localmente",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "contextMenus",
        "identity",
        "identity.email"
    ],
    "action": {
        "default_popup": "src/popup/popup.html",
        "default_icon": "icons/icon48.png"
    },
    "background": {
        "service_worker": "src/js/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/js/content.js"
            ]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}